{
  "name": "forgeui",
  "version": "0.8.0-dev",
  "description": "A pragmatic, accessible React component library with first-class theming.",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "eslint src tests",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "5.16.5",
    "@testing-library/react": "10.4.9",
    "@testing-library/user-event": "12.8.3",
    "@types/jest": "25.2.3",
    "@types/node": "14.18.63",
    "@types/react": "17.0.13",
    "@types/react-dom": "17.0.6",
    "@typescript-eslint/eslint-plugin": "4.33.0",
    "@typescript-eslint/parser": "4.33.0",
    "eslint": "7.0.0",
    "eslint-plugin-react": "7.28.0",
    "eslint-plugin-react-hooks": "4.2.0",
    "jest": "25.5.4",
    "jsdom": "16.7.0",
    "prettier": "2.3.2",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "ts-jest": "25.5.1",
    "typescript": "3.8.3"
  },
  "engines": {
    "node": ">=14"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "typescript",
    "a11y"
  ],
  "publishConfig": {
    "access": "public"
  }
}
